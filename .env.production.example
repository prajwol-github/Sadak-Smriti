# Production Environment Template (.env.production)
# Copy to /srv/sadak/production/.env.production on the server and chmod 600.
# Never commit real passwords or secrets to Git.

# --- Database (infra/docker-compose.production.yml) ---
DB_PORT=5433
POSTGRES_DB=sadak
POSTGRES_PASSWORD=generate-strong-prod-postgres-pw
MIGRATOR_PASSWORD=generate-strong-prod-migrator-pw
APP_PASSWORD=generate-strong-prod-app-pw
READONLY_PASSWORD=generate-strong-prod-readonly-pw

# App connection string (read/write, no DDL):
DATABASE_URL=postgres://app:generate-strong-prod-app-pw@127.0.0.1:5433/sadak
# Migrator connection string (DDL):
MIGRATOR_DATABASE_URL=postgres://migrator:generate-strong-prod-migrator-pw@127.0.0.1:5433/sadak

# --- Crash report form ---
# Set to false initially until Cloudflare, Turnstile, and rate limits are verified live
REPORTS_ENABLED=false
# 32 random bytes in hex: openssl rand -hex 32
IP_HASH_SECRET=
# 32 random bytes in hex: openssl rand -hex 32. Keep out of backups; loss makes reporter contacts unreadable.
CONTACT_ENCRYPTION_KEY=
# Production Cloudflare Turnstile keys (lib/net/turnstile.ts refuses test keys in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Auth & Host URL (Production) ---
PORT=3000
HOSTNAME=127.0.0.1
BETTER_AUTH_URL=https://example.org
SITE_URL=https://example.org
# 32 random bytes in base64: openssl rand -base64 32. Changing this invalidates all sessions and TOTP secrets.
BETTER_AUTH_SECRET=

# Google OAuth Credentials for Production (Google Cloud Console)
# Authorized redirect URI: https://example.org/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

