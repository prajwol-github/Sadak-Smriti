# Copy to .env.local for development. Never commit .env.local.
# These values are for the local Docker database only. Production values live in the
# server's environment file (mode 600) and in GitHub Actions secrets (SPEC 12.2).

# --- Database (pnpm db:up) ---
DB_PORT=5433
POSTGRES_PASSWORD=dev-only-postgres
MIGRATOR_PASSWORD=dev-only-migrator
APP_PASSWORD=dev-only-app
READONLY_PASSWORD=dev-only-readonly
# What the website connects as (no DDL):
DATABASE_URL=postgres://app:dev-only-app@localhost:5433/sadak
# What migrations run as:
MIGRATOR_DATABASE_URL=postgres://migrator:dev-only-migrator@localhost:5433/sadak

# --- Crash report form (docs/plans/report-a-crash.md) ---
# Set to false to close the form at once (flood or attack).
REPORTS_ENABLED=true
# Secret for hashing visitors' IP addresses. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
# 32-byte key, hex, for reporters' optional contact details. Generate the same way. Keep it out of backups.
CONTACT_ENCRYPTION_KEY=
# Cloudflare Turnstile. These are Cloudflare's published test keys (always pass). In production the form refuses to run with them (lib/net/turnstile.ts); create a real widget.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Sign-in (ADR 0006) ---
# Where the site is reached; Google sends people back here. Production: https://<your domain>
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out and makes stored authenticator secrets unreadable, so keep it.
BETTER_AUTH_SECRET=
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
