# Staging Environment Template (.env.staging)
# Copy to /srv/sadak/staging/.env.staging on the server and chmod 600.
# Never commit real passwords or secrets to Git.

# --- Database (infra/docker-compose.staging.yml) ---
DB_PORT=5434
POSTGRES_DB=sadak_staging
POSTGRES_PASSWORD=generate-strong-staging-postgres-pw
MIGRATOR_PASSWORD=generate-strong-staging-migrator-pw
APP_PASSWORD=generate-strong-staging-app-pw
READONLY_PASSWORD=generate-strong-staging-readonly-pw

# App connection string (read/write, no DDL):
DATABASE_URL=postgres://app:generate-strong-staging-app-pw@127.0.0.1:5434/sadak_staging
# Migrator connection string (DDL):
MIGRATOR_DATABASE_URL=postgres://migrator:generate-strong-staging-migrator-pw@127.0.0.1:5434/sadak_staging

# --- Crash report form ---
# Set to false to close report submission during testing or maintenance
REPORTS_ENABLED=true
# 32 random bytes in hex: openssl rand -hex 32
IP_HASH_SECRET=
# 32 random bytes in hex: openssl rand -hex 32
CONTACT_ENCRYPTION_KEY=
# Cloudflare Turnstile keys for staging domain (staging.example.org)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Auth & Host URL (Staging) ---
PORT=3001
HOSTNAME=127.0.0.1
BETTER_AUTH_URL=https://staging.example.org
SITE_URL=https://staging.example.org
# 32 random bytes in base64: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth Credentials for Staging (Google Cloud Console)
# Authorized redirect URI: https://staging.example.org/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

