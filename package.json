{
  "name": "sadak-smriti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sample": "cross-env SAMPLE_DATA=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "cross-env DB_TESTS=1 vitest run",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "map:download": "bash scripts/map/download-sources.sh",
    "map:build": "tsx scripts/map/build-map-data.ts",
    "screenshot": "node scripts/dev/screenshot.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml --env-file .env.local up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml --env-file .env.local down",
    "db:reset": "docker compose -f infra/docker-compose.yml --env-file .env.local down -v && pnpm db:up && pnpm db:migrate",
    "db:up:staging": "docker compose -f infra/docker-compose.staging.yml --env-file .env.staging up -d --wait",
    "db:down:staging": "docker compose -f infra/docker-compose.staging.yml --env-file .env.staging down",
    "db:up:production": "docker compose -f infra/docker-compose.production.yml --env-file .env.production up -d --wait",
    "db:down:production": "docker compose -f infra/docker-compose.production.yml --env-file .env.production down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:queries": "tsx scripts/db/queries.ts",
    "db:places:download": "bash scripts/db/download-place-names.sh",
    "db:places": "tsx scripts/db/import-places.ts",
    "db:pending": "tsx scripts/db/pending.ts",
    "contributors:avatars": "tsx scripts/contributors/fetch-avatars.ts",
    "users:role": "tsx scripts/db/set-role.ts",
    "pipeline:outlets": "tsx scripts/db/sync-outlets.ts",
    "worker": "tsx worker/index.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "better-auth": "1.7.22",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.0",
    "maplibre-gl": "6.18.0",
    "nepali-date-converter": "^3.4.2",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pmtiles": "4.5.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "nepali-datetime": "2.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "AGPL-3.0-only"
}
